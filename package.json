{
  "name": "dni-redactor",
  "version": "0.0.0",
  "private": true,
  "description": "Browser-only tool to redact a Spanish DNI photo before sharing a copy.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --strictPort --port 4173",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-plugin-svelte": "3.24.1",
    "neostandard": "0.14.1",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@tesseract.js-data/spa": "1.0.0",
    "tesseract.js": "7.0.0",
    "wasm-feature-detect": "1.10.1"
  },
  "packageManager": "pnpm@12.23.0"
}
