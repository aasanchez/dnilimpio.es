// SPDX-License-Identifier: AGPL-3.0-or-later
// Cloudflare Workers hosting of dnitapado.es (ADR 0027): static files, plus one Worker route for the
// opt-in usage stats (POST /stats, worker/index.ts, ADR 0029). Every other request is a static file
// and never runs Worker code. CI deploys the tested `dist` artifact with the `_headers` file of
// scripts/headers.ts added.
{
  "$schema": "./deploy/node_modules/wrangler/config-schema.json",
  "name": "dnitapado",
  "compatibility_date": "2026-11-01",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The Worker runs for this one path only; everything else is served as a static file first.
    "run_worker_first": ["/stats"],
    // Every file at its own path, with no redirect: the service worker downloads `index.html` by name,
    // and a page load must never be answered with a redirected response.
    "html_handling": "none",
    // `/` (and any unknown path) answers with index.html, as GitHub Pages does for `/`.
    "not_found_handling": "single-page-application"
  },
  // Opt-in usage stats (ADR 0029): one row per send, no IP address, no cookie.
  "analytics_engine_datasets": [
    { "binding": "STATS", "dataset": "dnitapado_usage" }
  ],
  // No request logs: the Worker keeps nothing about who sent the stats.
  "observability": { "enabled": false },
  // Only the custom domains below serve the app: no second copy at a workers.dev address.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "dnitapado.es", "custom_domain": true },
    { "pattern": "www.dnitapado.es", "custom_domain": true }
  ]
}
