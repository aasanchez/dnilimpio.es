    {
      "id": 12,
      "type": "table",
      "title": "Covered fields, share of uses per document",
      "description": "How often each field was covered, as a share of that document's uses. Columns double9 to double19, one per field in the order of FIELDS (src/stats/schema.ts). A field that a document does not have stays at 0.",
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${DS_ANALYTICS_ENGINE}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${DS_ANALYTICS_ENGINE}"
          },
          "refId": "A",
          "query": "SELECT blob2 AS doc,\n       SUM(_sample_interval) AS uses,\n       SUM(_sample_interval * double9) / SUM(_sample_interval) AS signature,\n       SUM(_sample_interval * double10) / SUM(_sample_interval) AS issueDate,\n       SUM(_sample_interval * double11) / SUM(_sample_interval) AS expiryDate,\n       SUM(_sample_interval * double12) / SUM(_sample_interval) AS supportNumber,\n       SUM(_sample_interval * double13) / SUM(_sample_interval) AS can,\n       SUM(_sample_interval * double14) / SUM(_sample_interval) AS mrz,\n       SUM(_sample_interval * double15) / SUM(_sample_interval) AS address,\n       SUM(_sample_interval * double16) / SUM(_sample_interval) AS placeOfBirth,\n       SUM(_sample_interval * double17) / SUM(_sample_interval) AS parents,\n       SUM(_sample_interval * double18) / SUM(_sample_interval) AS dateOfBirth,\n       SUM(_sample_interval * double19) / SUM(_sample_interval) AS permitType\nFROM dnitapado_usage\nWHERE $timeFilter\nGROUP BY doc\nORDER BY uses DESC",
          "rawQuery": true,
          "format": "table",
          "dateTimeType": "DATETIME",
          "dateTimeColDataType": "timestamp",
          "dateColDataType": "",
          "database": "",
          "table": "dnitapado_usage",
          "round": "0s",
          "intervalFactor": 1,
          "extrapolate": false,
          "skip_comments": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "custom": {
            "cellOptions": {
              "type": "color-background",
              "mode": "gradient"
            }
          },
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "min": 0,
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "doc"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "uses"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
