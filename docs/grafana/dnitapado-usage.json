            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Uses over time, per document",
      "description": "Uses per time bucket, one line per document type. The bucket follows the zoom level ($timeSeries).",
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${DS_ANALYTICS_ENGINE}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${DS_ANALYTICS_ENGINE}"
          },
          "refId": "A",
          "query": "SELECT $timeSeries AS t, blob2 AS doc, SUM(_sample_interval) AS uses\nFROM dnitapado_usage\nWHERE $timeFilter\nGROUP BY doc, t\nORDER BY t",
          "rawQuery": true,
          "format": "time_series",
          "dateTimeType": "DATETIME",
          "dateTimeColDataType": "timestamp",
          "dateColDataType": "",
          "database": "",
          "table": "dnitapado_usage",
          "round": "0s",
          "intervalFactor": 1,
          "extrapolate": false,
          "skip_comments": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
