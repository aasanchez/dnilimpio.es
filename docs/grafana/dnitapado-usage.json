{
  "__inputs": [
    {
      "name": "DS_ANALYTICS_ENGINE",
      "label": "Workers Analytics Engine",
      "description": "The Altinity plugin for ClickHouse data source that points at the Analytics Engine SQL API.",
      "type": "datasource",
      "pluginId": "vertamedia-clickhouse-datasource",
      "pluginName": "Altinity plugin for ClickHouse"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "vertamedia-clickhouse-datasource",
      "name": "Altinity plugin for ClickHouse",
      "version": "3.1.1"
    }
  ],
  "title": "DNI Tapado.es usage stats",
  "uid": "dnitapado-usage",
  "description": "Opt-in anonymous usage stats (ADR 0029, ADR 0047), read from Workers Analytics Engine dataset dnitapado_usage. Setup: docs/GRAFANA.md.",
  "tags": [
    "dnitapado"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "",
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Uses",
      "description": "Uses sent in the time range: one per tap on Send on the thanks page. SUM(_sample_interval) corrects for Analytics Engine sampling.",
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${DS_ANALYTICS_ENGINE}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${DS_ANALYTICS_ENGINE}"
          },
          "refId": "A",
          "query": "SELECT SUM(_sample_interval) AS uses\nFROM dnitapado_usage\nWHERE $timeFilter",
          "rawQuery": true,
          "format": "table",
          "dateTimeType": "DATETIME",
          "dateTimeColDataType": "timestamp",
          "dateColDataType": "",
          "database": "",
          "table": "dnitapado_usage",
          "round": "0s",
          "intervalFactor": 1,
          "extrapolate": false,
          "skip_comments": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "sum"
          ],
          "fields": ""
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Detection right",
      "description": "Automatic document detection: share of uses where it ran (right, wrong or none) and preselected the document the person kept. Uses with 'off' (it could not run) are left out.",
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${DS_ANALYTICS_ENGINE}"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${DS_ANALYTICS_ENGINE}"
          },
          "refId": "A",
          "query": "SELECT sumIf(_sample_interval, blob3 = 'right') / sumIf(_sample_interval, blob3 IN ('right', 'wrong', 'none')) AS right_rate\nFROM dnitapado_usage\nWHERE $timeFilter",
          "rawQuery": true,
          "format": "table",
          "dateTimeType": "DATETIME",
          "dateTimeColDataType": "timestamp",
          "dateColDataType": "",
          "database": "",
          "table": "dnitapado_usage",
          "round": "0s",
          "intervalFactor": 1,
          "extrapolate": false,
          "skip_comments": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Uses with a moved box",
      "description": "Share of uses where the person moved or resized at least one cover box by hand (list version 2 and later, ADR 0047).",
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${DS_ANALYTICS_ENGINE}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${DS_ANALYTICS_ENGINE}"
          },
          "refId": "A",
          "query": "SELECT sumIf(_sample_interval, double20 > 0) / SUM(_sample_interval) AS moved_rate\nFROM dnitapado_usage\nWHERE $timeFilter AND blob1 NOT IN ('1')",
          "rawQuery": true,
          "format": "table",
          "dateTimeType": "DATETIME",
          "dateTimeColDataType": "timestamp",
          "dateColDataType": "",
          "database": "",
          "table": "dnitapado_usage",
          "round": "0s",
          "intervalFactor": 1,
          "extrapolate": false,
          "skip_comments": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Back photo used",
      "description": "Share of uses with a photo of the card's back.",
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${DS_ANALYTICS_ENGINE}"
      },
      "gridPos": {
        "x": 18,
