          "rawQuery": true,
          "format": "table",
          "dateTimeType": "DATETIME",
          "dateTimeColDataType": "timestamp",
          "dateColDataType": "",
          "database": "",
          "table": "dnitapado_usage",
          "round": "0s",
          "intervalFactor": 1,
          "extrapolate": false,
          "skip_comments": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
